rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid));
    }
    match /cafes/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null
        && resource.data.plan == 'pro'
        && request.auth.token.email == resource.data.ownerEmail
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['menu', 'updatedAt'])
      );
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
  }
}
